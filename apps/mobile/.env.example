# Supabase Configuration for ProxiCommerce OS Mobile
# Copy this file to .env inside apps/mobile/ and fill with your Supabase project credentials:
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key

# Google OAuth client IDs (public identifiers; never put client secrets in the app).
# Drive backups are manual and independent of the optional Supabase sync.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional AI receipt scanning provider (OpenAI-compatible multimodal chat completions API).
# The scanner is disabled by default; see the README before enabling it.
# These EXPO_PUBLIC_ values are bundled into the app. Use only for local testing,
# never ship a real provider secret in a production mobile app.
EXPO_PUBLIC_AI_API_URL=https://your-provider.example/v1/chat/completions
EXPO_PUBLIC_AI_MODEL=your-vision-model
EXPO_PUBLIC_AI_API_KEY=your-api-key
