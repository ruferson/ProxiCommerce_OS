# Supabase Configuration for ProxiCommerce OS Mobile
# Copy this file to .env inside apps/mobile/ and fill with your Supabase project credentials:
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key

# Google OAuth client IDs (public identifiers; never put client secrets in the app).
# Drive backups are manual and independent of the optional Supabase sync.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
