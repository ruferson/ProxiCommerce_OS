{
  "scheme": "proxicommerce",
  "ios": {
    "bundleIdentifier": "com.proxicommerce.app"
  },
  "android": {
    "package": "com.proxicommerce.app",
    "scheme": "com.proxicommerce.app",
    "permissions": [
      "android.permission.CAMERA"
    ]
  },
  "plugins": [
    [
      "expo-camera",
      {
        "cameraPermission": "Permite que ProxiCommerce use la cámara para escanear códigos y fotografiar productos.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }
    ],
    [
      "expo-image-picker",
      {
        "cameraPermission": "Permite que ProxiCommerce use la cámara para escanear códigos y fotografiar productos.",
        "photosPermission": false,
        "microphonePermission": false
      }
    ],
    "expo-sqlite",
    "expo-status-bar",
    "expo-web-browser"
  ],
  "extra": {
    "eas": {
      "projectId": "8b8ac434-f171-4a96-8560-0e1791f5e379"
    }
  },
  "owner": "rufersons-team",
  "slug": "proxycommerceos"
}
